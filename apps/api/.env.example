NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000

# Postgres (docker-compose exposes pgvector-enabled Postgres on 5432)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_pdf_assistant

# Redis (cache, BullMQ queues, rate limiting, session-scoped BYOK keys)
REDIS_URL=redis://localhost:6380

# Auth (generate with: openssl rand -base64 32)
JWT_SECRET=
JWT_REFRESH_SECRET=

# Object storage — MinIO locally (S3-compatible), swap for R2/S3 in prod
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=ai-pdf-documents
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
# STORAGE_REGION=us-east-1 # optional; MinIO ignores it, real S3/R2 may want it set

# NOTE: this is NOT the user's BYOK Gemini key (that's session-scoped, never
# an env var). This one only exists if the server itself ever needs to call
# Gemini for non-user-attributed work (none in V1) — leave unset otherwise.
# GEMINI_API_KEY=

# Bulk-embedding pacing — sized for Gemini's free-tier limits (observed:
# 100 req/min for embed_content). Raise EMBED_MIN_INTERVAL_MS's divisor if
# you're on a paid key with a higher quota; leave unset otherwise.
# EMBED_MIN_INTERVAL_MS=700
# EMBED_MAX_RETRIES=5
